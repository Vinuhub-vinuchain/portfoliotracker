    <script>
        // Configuration
        const CONFIG = {
            RPC_URLS: ['https://rpc.vinuchain.org', 'https://vinuchain-rpc.com'],
            CHAIN_ID: 207,
            COINGECKO_VC_ID: 'vinuchain',
            EXPLORER_URL: 'https://vinuexplorer.org'
        };

        let web3 = null;
        let currentAddress = '';
        let portfolioData = [];
        let tokens = JSON.parse(localStorage.getItem('vinuTokens') || '[]');
        let watchlist = JSON.parse(localStorage.getItem('vinuWatchlist') || '[]');
        let vcAlert = JSON.parse(localStorage.getItem('vinuVCAlert') || '{}');
        let chartInstance = null;
        let currentRpcIndex = 0;
        let isConnected = false;

        // ERC-20 ABI
        const ERC20_ABI = [
            {"constant":true,"inputs":[{"name":"_owner","type":"address"}],"name":"balanceOf","outputs":[{"name":"balance","type":"uint256"}],"type":"function"},
            {"constant":true,"inputs":[],"name":"decimals","outputs":[{"name":"","type":"uint8"}],"type":"function"},
            {"constant":true,"inputs":[],"name":"symbol","outputs":[{"name":"","type":"string"}],"type":"function"}
        ];

        // Retry Utility
        async function withRetry(fn, maxAttempts = 3, delay = 1000) {
            for (let i = 0; i < maxAttempts; i++) {
                try {
                    return await fn();
                } catch (error) {
                    if (i === maxAttempts - 1) throw error;
                    await new Promise(resolve => setTimeout(resolve, delay));
                }
            }
        }

        // Initialize Web3
        async function initWeb3() {
            for (let i = 0; i < CONFIG.RPC_URLS.length; i++) {
                try {
                    web3 = new Web3(CONFIG.RPC_URLS[i]);
                    await withRetry(() => web3.eth.getBlockNumber());
                    currentRpcIndex = i;
                    document.getElementById('rpcStatus').textContent = CONFIG.RPC_URLS[i];
                    return true;
                } catch (error) {
                    console.warn(`RPC ${CONFIG.RPC_URLS[i]} failed: ${error.message}`);
                }
            }
            showError('All RPCs failed. Try again later or check network.');
            return false;
        }

        // Detect MetaMask
        function detectMetaMask() {
            if (typeof window.ethereum !== 'undefined' && window.ethereum.isMetaMask) {
                updateWalletStatus('MetaMask detected! Click connect to proceed.', 'status-detected');
                document.getElementById('connectBtn').disabled = false;
                return true;
            } else {
                updateWalletStatus('MetaMask not detected. Please install it from metamask.io.', 'status-error');
                document.getElementById('connectBtn').disabled = true;
                return false;
            }
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', async () => {
            await initWeb3();
            detectMetaMask();
            loadTokens();
            loadWatchlist();
            if (vcAlert.price) {
                document.getElementById('alertPrice').value = vcAlert.price;
                document.getElementById('alertEmail').value = vcAlert.email || '';
                loadVCAlert();
            }
            if (watchlist.length > 0) {
                currentAddress = watchlist[0];
                document.getElementById('walletInput').value = currentAddress;
                loadData();
            }
            setInterval(loadData, 60000);
            setInterval(checkVCAlert, 60000);
            updateVCPrice();
        });

        // Wallet Connection
        async function connectWallet() {
            if (!detectMetaMask()) return;
            const connectBtn = document.getElementById('connectBtn');
            connectBtn.disabled = true;
            connectBtn.textContent = 'Connecting...';
            try {
                showLoading(true);
                const chainIdHex = '0x' + CONFIG.CHAIN_ID.toString(16);
                try {
                    await window.ethereum.request({
                        method: 'wallet_switchEthereumChain',
                        params: [{ chainId: chainIdHex }],
                    });
                } catch (switchError) {
                    if (switchError.code === 4902) {
                        await window.ethereum.request({
                            method: 'wallet_addEthereumChain',
                            params: [{
                                chainId: chainIdHex,
                                chainName: 'VinuChain',
                                nativeCurrency: { name: 'VinuCoin', symbol: 'VC', decimals: 18 },
                                rpcUrls: CONFIG.RPC_URLS,
                                blockExplorerUrls: [CONFIG.EXPLORER_URL]
                            }],
                        });
                    } else {
                        throw switchError;
                    }
                }

                const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
                currentAddress = accounts[0];
                document.getElementById('walletInput').value = currentAddress;
                web3 = new Web3(window.ethereum);
                isConnected = true;
                connectBtn.textContent = 'Connected ✅';
                updateWalletStatus('Connected: ' + shortenAddress(currentAddress), 'status-connected');
                addToWatchlist();
                await loadData();
            } catch (error) {
                if (error.code === 4001) {
                    showError('Connection rejected by user.');
                } else {
                    showError('Connection failed: ' + (error.message || 'Unknown error'));
                }
                connectBtn.textContent = 'Connect MetaMask';
                connectBtn.disabled = false;
            } finally {
                showLoading(false);
            }
        }

        // Track Address
        async function setWalletAndLoad() {
            const address = document.getElementById('walletInput').value.trim();
            if (web3.utils.isAddress(address)) {
                currentAddress = address;
                await loadData();
                addToWatchlist();
            } else {
                showError('Invalid address');
            }
        }

        // Data Loading
        async function loadData() {
            if (!currentAddress || !web3) return;
            showLoading(true);
            try {
                updateWalletStatus(`Scanning ${shortenAddress(currentAddress)}`, 'loading');
                await loadNetworkStats();
                await loadPortfolio();
                await loadTransactions();
                document.getElementById('explorerLink').href = `${CONFIG.EXPLORER_URL}/address/${currentAddress}`;
                document.getElementById('txExplorerLink').href = `${CONFIG.EXPLORER_URL}/address/${currentAddress}?tab=tx`;
                updateWalletStatus(`Loaded for ${shortenAddress(currentAddress)}`, 'success');
            } catch (error) {
                showError('Load failed: ' + error.message + '. Try adding tokens manually.');
            } finally {
                showLoading(false);
            }
        }

        async function loadNetworkStats() {
            try {
                const blockNumber = await withRetry(() => web3.eth.getBlockNumber());
                document.getElementById('latestBlock').textContent = blockNumber;
                document.getElementById('gasPrice').textContent = '0 (Feeless)';
                document.getElementById('networkStatus').textContent = '✅ Active';
                document.getElementById('networkStats').style.display = 'grid';
                await updateVCPrice();
            } catch (error) {
                console.error('Stats error:', error);
                showError('Failed to load network stats.');
            }
        }

        async function updateVCPrice() {
            try {
                const priceData = await getTokenPrice(CONFIG.COINGECKO_VC_ID);
                document.getElementById('vcPrice').textContent = priceData.usd ? `$${priceData.usd.toFixed(4)}` : 'Unavailable';
            } catch (error) {
                document.getElementById('vcPrice').textContent = 'Unavailable';
                console.error('VC price fetch error:', error);
            }
        }

        async function loadPortfolio() {
            try {
                portfolioData = [];
                let totalValue = 0;
                document.getElementById('portfolioLoading').classList.remove('hidden');

                // Always include VC (Native)
                let vcBalance = 0;
                let vcPrice = 0;
                try {
                    const vcBalanceWei = await withRetry(() => web3.eth.getBalance(currentAddress));
                    vcBalance = parseFloat(web3.utils.fromWei(vcBalanceWei, 'ether'));
                    const vcPriceData = await getTokenPrice(CONFIG.COINGECKO_VC_ID);
                    vcPrice = vcPriceData.usd || 0;
                } catch (error) {
                    console.warn('VC balance/price error:', error);
                }
                const vcValue = vcBalance * vcPrice;
                portfolioData.push({
                    symbol: 'VC (Native)',
                    balance: vcBalance,
                    price_usd: vcPrice,
                    value_usd: vcValue,
                    contract: 'native'
                });
                totalValue += vcValue;

                // Auto-detect ERC-20 tokens
                let tokenContracts = new Set();
                try {
                    const latestBlock = await withRetry(() => web3.eth.getBlockNumber());
                    const fromBlock = Math.max(0, latestBlock - 50000);
                    const topics = [
                        web3.utils.sha3('Transfer(address,address,uint256)'),
                        null,
                        web3.utils.padLeft(currentAddress.toLowerCase(), 64)
                    ];
                    const logs = await withRetry(() => web3.eth.getPastLogs({
                        fromBlock,
                        toBlock: 'latest',
                        topics
                    }));
                    logs.forEach(log => {
                        if (log.address) tokenContracts.add(log.address);
                    });
                } catch (error) {
                    console.warn('Token detection error:', error);
                    showError('Failed to detect tokens. Manually added tokens will still display.');
                }

                // Include manually added tokens
                tokens.forEach(token => tokenContracts.add(token.contract));

                // Query balances for ERC-20 tokens
                for (const contract of tokenContracts) {
                    if (contract === 'native') continue;
                    try {
                        const tokenContract = new web3.eth.Contract(ERC20_ABI, contract);
                        let symbol = tokens.find(t => t.contract.toLowerCase() === contract.toLowerCase())?.symbol || 'Unknown';
                        let decimals = 18;
                        try {
                            if (symbol === 'Unknown') symbol = await withRetry(() => tokenContract.methods.symbol().call());
                            decimals = await withRetry(() => tokenContract.methods.decimals().call());
                        } catch (err) {
                            console.warn(`Failed to fetch symbol/decimals for ${contract}: ${err.message}`);
                        }
                        const balanceWei = await withRetry(() => tokenContract.methods.balanceOf(currentAddress).call());
                        const balance = parseFloat(balanceWei) / Math.pow(10, decimals);
                        portfolioData.push({
                            symbol,
                            balance,
                            price_usd: 0,
                            value_usd: 0,
                            contract
                        });
                    } catch (err) {
                        console.warn(`Error processing token ${contract}: ${err.message}`);
                        showError(`Failed to load token ${contract}. Verify contract address.`);
                    }
                }

                // Sort portfolio: VC first, then non-zero balances, then zero balances
                portfolioData.sort((a, b) => {
                    if (a.symbol === 'VC (Native)') return -1;
                    if (b.symbol === 'VC (Native)') return 1;
                    return b.balance - a.balance;
                });

                forcePortfolioUpdate(totalValue);
            } catch (error) {
                console.error('Portfolio error:', error);
                showError('Failed to load portfolio. Manually added tokens will still display.');
                forcePortfolioUpdate(0);
            } finally {
                document.getElementById('portfolioLoading').classList.add('hidden');
            }
        }

        function forcePortfolioUpdate(totalValue) {
            if (!portfolioData.some(item => item.symbol === 'VC (Native)')) {
                portfolioData.unshift({
                    symbol: 'VC (Native)',
                    balance: 0,
                    price_usd: 0,
                    value_usd: 0,
                    contract: 'native'
                });
            }
            displayPortfolio(totalValue);
            displayChart();
        }

        async function loadTransactions() {
            try {
                const txCount = await withRetry(() => web3.eth.getTransactionCount(currentAddress));
                document.getElementById('txSummary').innerHTML = `<strong>${txCount}</strong> transactions found.`;
                document.getElementById('txCard').style.display = 'block';
            } catch (error) {
                console.error('Tx error:', error);
                document.getElementById('txSummary').innerHTML = 'Unable to load transactions.';
            }
        }

        // Display Functions
        function displayPortfolio(totalValue) {
            const tableBody = document.querySelector('#portfolioTable tbody');
            tableBody.innerHTML = '';
            if (portfolioData.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="5" class="no-data">No tokens found. Add tokens or check address.</td></tr>';
            } else {
                let hasNonZeroBalance = false;
                portfolioData.forEach(item => {
                    if (item.balance > 0) hasNonZeroBalance = true;
                    const allocation = totalValue > 0 ? (item.value_usd / totalValue * 100) : 0;
                    const row = tableBody.insertRow();
                    row.innerHTML = `
                        <td>${item.symbol}<br><small>${shortenAddress(item.contract)}</small></td>
                        <td>${item.balance.toFixed(6)}</td>
                        <td>$${item.price_usd.toFixed(4)}</td>
                        <td>$${item.value_usd.toFixed(2)}</td>
                        <td>${allocation.toFixed(1)}%</td>
                    `;
                });
                if (!hasNonZeroBalance && portfolioData.length === 1 && portfolioData[0].symbol === 'VC (Native)') {
                    tableBody.innerHTML = '<tr><td colspan="5" class="no-data">No tokens held. VC (Native) balance is 0.</td></tr>';
                }
            }
            document.getElementById('totalValue').textContent = totalValue.toFixed(2);
            const top = portfolioData.length > 0 
                ? portfolioData.reduce((prev, curr) => prev.value_usd > curr.value_usd ? prev : curr, {symbol: '-', value_usd: 0})
                : {symbol: '-', value_usd: 0};
            document.getElementById('topHolding').innerHTML = `${top.symbol}: $${top.value_usd.toFixed(2)}`;
            document.getElementById('pnlDisplay').innerHTML = `24h Change: <span id="vcPnl">Loading...</span>`;
            getTokenPrice(CONFIG.COINGECKO_VC_ID).then(data => {
                const pnl = data.usd_24h_change || 0;
                document.getElementById('vcPnl').innerHTML = `${pnl >= 0 ? '+' : ''}${pnl.toFixed(2)}%`;
                document.getElementById('vcPnl').style.color = pnl >= 0 ? '#00ff88' : '#ff4444';
            });
            document.getElementById('portfolioCard').style.display = 'block';
        }

        function displayChart() {
            const ctx = document.getElementById('portfolioChart').getContext('2d');
            if (chartInstance) chartInstance.destroy();
            chartInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: portfolioData.length > 0 ? portfolioData.map(item => item.symbol) : ['No Data'],
                    datasets: [{
                        data: portfolioData.length > 0 ? portfolioData.map(item => item.value_usd || item.balance) : [1],
                        backgroundColor: portfolioData.length > 0 
                            ? ['#ffffff', '#cccccc', '#999999', '#666666', '#333333'].slice(0, portfolioData.length)
                            : ['#333333'],
                        borderColor: '#000000',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { color: '#ffffff', font: { size: 12 } } }
                    }
                }
            });
        }

        // Token Management
        async function addToken() {
            const contract = document.getElementById('tokenContract').value.trim();
            let symbol = document.getElementById('tokenSymbol').value.trim();
            if (!web3.utils.isAddress(contract)) {
                showError('Invalid contract address. Please verify.');
                return;
            }
            try {
                const tokenContract = new web3.eth.Contract(ERC20_ABI, contract);
                if (!symbol) {
                    try {
                        symbol = await withRetry(() => tokenContract.methods.symbol().call());
                    } catch {
                        symbol = 'Unknown';
                    }
                }
                let decimals = 18;
                try {
                    decimals = await withRetry(() => tokenContract.methods.decimals().call());
                } catch (err) {
                    console.warn(`Failed to fetch decimals for ${contract}: ${err.message}`);
                }
                const balanceWei = await withRetry(() => tokenContract.methods.balanceOf(currentAddress).call());
                const balance = parseFloat(balanceWei) / Math.pow(10, decimals);
                
                if (!tokens.find(t => t.contract.toLowerCase() === contract.toLowerCase())) {
                    tokens.push({ symbol, contract });
                    localStorage.setItem('vinuTokens', JSON.stringify(tokens));
                    // Add to portfolioData immediately
                    portfolioData.push({
                        symbol,
                        balance,
                        price_usd: 0,
                        value_usd: 0,
                        contract
                    });
                    loadTokens();
                    document.getElementById('tokenSymbol').value = '';
                    document.getElementById('tokenContract').value = '';
                    forcePortfolioUpdate(portfolioData.find(p => p.symbol === 'VC (Native)')?.value_usd || 0);
                    showSuccess(`Token ${symbol} added and displayed in portfolio!`);
                } else {
                    showError('Token already added');
                }
            } catch (error) {
                console.error('Add token error:', error);
                showError(`Failed to add token. Verify contract address: ${error.message}`);
            }
        }

        function loadTokens() {
            const container = document.getElementById('tokensList');
            container.innerHTML = '<h4>Tracked Tokens:</h4>';
            if (tokens.length === 0) {
                container.innerHTML += '<p class="no-data">No tokens added. Use the form above to add ERC-20 tokens.</p>';
            } else {
                tokens.forEach((token, index) => {
                    container.innerHTML += `
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px; border-bottom: 1px solid #333;">
                            <span>${token.symbol} (${shortenAddress(token.contract)})</span>
                            <button class="btn btn-small btn-danger" onclick="removeToken(${index})">Remove</button>
                        </div>
                    `;
                });
            }
        }

        function removeToken(index) {
            const removedContract = tokens[index].contract;
            tokens.splice(index, 1);
            localStorage.setItem('vinuTokens', JSON.stringify(tokens));
            portfolioData = portfolioData.filter(p => p.contract !== removedContract);
            loadTokens();
            forcePortfolioUpdate(portfolioData.find(p => p.symbol === 'VC (Native)')?.value_usd || 0);
            showSuccess('Token removed from portfolio.');
        }

        // Watchlist
        function addToWatchlist() {
            if (!currentAddress || watchlist.includes(currentAddress)) return;
            watchlist.unshift(currentAddress);
            if (watchlist.length > 10) watchlist = watchlist.slice(0, 10);
            localStorage.setItem('vinuWatchlist', JSON.stringify(watchlist));
            loadWatchlist();
            showSuccess('Added to watchlist');
        }

        function loadWatchlist() {
            const container = document.getElementById('tokensList');
            container.innerHTML += '<h4>Watchlist:</h4>';
            if (watchlist.length === 0) {
                container.innerHTML += '<p class="no-data">No addresses in watchlist.</p>';
            } else {
                watchlist.forEach((address, index) => {
                    container.innerHTML += `
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px; border-bottom: 1px solid #333;">
                            <span>${shortenAddress(address)}</span>
                            <div>
                                <button class="btn btn-small btn-primary" onclick="loadWallet('${address}')">Load</button>
                                <button class="btn btn-small btn-danger" onclick="removeFromWatchlist(${index})">Remove</button>
                            </div>
                        </div>
                    `;
                });
            }
        }

        function loadWallet(address) {
            currentAddress = address;
            document.getElementById('walletInput').value = address;
            loadData();
        }

        function removeFromWatchlist(index) {
            watchlist.splice(index, 1);
            localStorage.setItem('vinuWatchlist', JSON.stringify(watchlist));
            loadTokens();
        }

        // Alerts
        function setVCAlert() {
            const price = parseFloat(document.getElementById('alertPrice').value);
            const email = document.getElementById('alertEmail').value.trim();
            if (!isNaN(price) && email.includes('@')) {
                vcAlert = { price, email };
                localStorage.setItem('vinuVCAlert', JSON.stringify(vcAlert));
                loadVCAlert();
                showSuccess(`VC alert set at $${price} for ${email}`);
            } else {
                showError('Invalid price or email');
            }
        }

        function loadVCAlert() {
            const container = document.getElementById('alertsList');
            container.innerHTML = '';
            if (vcAlert.price) {
                container.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px; border-bottom: 1px solid #333;">
                        <span>VC > $${vcAlert.price} → ${vcAlert.email}</span>
                        <button class="btn btn-small btn-danger" onclick="clearVCAlert()">Remove</button>
                    </div>
                `;
            }
        }

        function clearVCAlert() {
            vcAlert = {};
            localStorage.removeItem('vinuVCAlert');
            document.getElementById('alertPrice').value = '';
            document.getElementById('alertEmail').value = '';
            loadVCAlert();
        }

        async function checkVCAlert() {
            if (vcAlert.price) {
                const data = await getTokenPrice(CONFIG.COINGECKO_VC_ID);
                if (data.usd > vcAlert.price) {
                    const message = `VC price alert! Current: $${data.usd.toFixed(4)} (Target: $${vcAlert.price})`;
                    console.log(`Would send email to ${vcAlert.email}: ${message}`);
                    alert(message);
                }
            }
        }

        // Share Link
        function generateShareLink() {
            const snapshot = encodeURIComponent(JSON.stringify({
                address: currentAddress,
                portfolio: portfolioData,
                timestamp: new Date().toISOString()
            }));
            const url = `${window.location.href}?snapshot=${snapshot}`;
            navigator.clipboard.writeText(url);
            showSuccess('Share link copied to clipboard!');
        }

        // Export
        function exportData() {
            const csv = 'Symbol,Balance,Price,Value\n' + portfolioData.map(d => `${d.symbol},${d.balance},${d.price_usd},${d.value_usd}`).join('\n');
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `vinu-portfolio-${shortenAddress(currentAddress)}.csv`;
            a.click();
        }

        // Utilities
        async function getTokenPrice(id) {
            try {
                const response = await fetch(`https://api.coingecko.com/api/v3/simple/price?ids=${id}&vs_currencies=usd&include_24hr_change=true`, { timeout: 15000 });
                return await response.json().then(data => data[id] || { usd: 0, usd_24h_change: 0 });
            } catch {
                return { usd: 0, usd_24h_change: 0 };
            }
        }

        function shortenAddress(address) {
            return address && address !== 'native' ? `${address.slice(0, 6)}...${address.slice(-4)}` : address;
        }

        function showLoading(show) {
            document.getElementById('loadingOverlay').classList.toggle('hidden', !show);
        }

        function showError(message) {
            const div = document.getElementById('errorDisplay');
            div.textContent = message;
            div.classList.remove('hidden');
            setTimeout(() => div.classList.add('hidden'), 5000);
        }

        function showSuccess(message) {
            const div = document.getElementById('errorDisplay');
            div.textContent = message;
            div.classList.add('success');
            div.classList.remove('hidden', 'error');
            setTimeout(() => div.classList.add('hidden'), 3000);
        }

        function updateWalletStatus(message, className = '') {
            const statusDiv = document.getElementById('walletStatus');
            statusDiv.innerHTML = `<div class="wallet-status ${className}">${message}</div>`;
        }
    </script>
</body>
</html>
